      "parameters": {
        "jsCode": "// Calculate current week number\nconst now = new Date();\nconst startOfYear = new Date(now.getFullYear(), 0, 1);\nconst pastDaysOfYear = (now - startOfYear) / 86400000;\nconst weekNumber = Math.ceil((pastDaysOfYear + startOfYear.getDay() + 1) / 7);\n\n// Get current date info\nconst currentDate = now.toLocaleDateString('en-US', { \n  weekday: 'long', \n  year: 'numeric', \n  month: 'long', \n  day: 'numeric' \n});\n\n// Add week info to all items\nfor (const item of $input.all()) {\n  item.json.weekNumber = weekNumber;\n  item.json.currentDate = currentDate;\n  item.json.formLink = 'https://docs.google.com/forms/d/e/1FAIpQLSc8HRhAj7a1XvmFWQ_IXQjEO6iwLeyYjYL7MIa7nsn4Y99QRg/viewform';\n}\n\nreturn $input.all();"
      },
