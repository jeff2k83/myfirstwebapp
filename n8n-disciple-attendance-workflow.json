        "emailType": "html",
        "message": "<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }\n    .container { max-width: 600px; margin: 0 auto; padding: 20px; }\n    .header { background-color: #4CAF50; color: white; padding: 20px; text-align: center; border-radius: 5px; }\n    .content { background-color: #f9f9f9; padding: 20px; margin-top: 20px; border-radius: 5px; }\n    .button { display: inline-block; padding: 12px 24px; background-color: #4CAF50; color: white; text-decoration: none; border-radius: 5px; margin-top: 15px; }\n    .footer { margin-top: 20px; text-align: center; font-size: 12px; color: #666; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <h2>📋 Disciple Program - Weekly Attendance</h2>\n    </div>\n    <div class=\"content\">\n      <p>Dear {{ $json.Name }},</p>\n      \n      <p>This is your weekly reminder to submit your attendance for the Disciple Program.</p>\n      \n      <p><strong>Week Number:</strong> {{ $json.weekNumber }}<br>\n      <strong>Date:</strong> {{ $json.currentDate }}</p>\n      \n      <p>Please take a moment to fill out the attendance form:</p>\n      \n      <a href=\"{{ $json.formLink }}\" class=\"button\">Submit Attendance Form</a>\n      \n      <p style=\"margin-top: 20px;\">Thank you for your continued participation in the Disciple Program. Your commitment to growth and leadership is appreciated!</p>\n      \n      <p>Blessings,<br>\n      <strong>Disciple Program Team</strong></p>\n    </div>\n    <div class=\"footer\">\n      <p>This is an automated reminder sent every Wednesday at 3:00 PM</p>\n    </div>\n  </div>\n</body>\n</html>",
        "options": {}
      },
